+//
+// LLAMA_EXPERT_EM_GPU: the expert-major matmul as MUL_MAT_ID dispatches on the GPU of the slots
+//
+
+// the staging buffers, once: two halves of em_gpu_chunk experts of the largest expert tensor, and the
+// activations, ids and results of em_gpu_pairs pairs. From the slots' host buffer type directly (no
+// fallback to the CPU, which would move the cache's type there), typed EXPERT_CACHE so that the
+// device's kernel reads the staged experts as it reads the slots
+static bool ec_em_gpu_alloc(llama_expert_cache & C) {
+    if (C.em_gpu_stage != nullptr) {
+        return true;
+    }
+    if (C.em_gpu_failed || C.gpu == nullptr || C.inner == nullptr) {
+        return false;
+    }
+    const size_t A = EC_DIRECT_ALIGN;
+    size_t  max_eb = 0;
+    int64_t max_k  = 0;
+    int64_t max_n  = 0;
+    for (const ec_tensor & T : C.tensors) {
+        max_eb = std::max(max_eb, T.eb);
+        max_k  = std::max(max_k, T.t->ne[0]);
+        max_n  = std::max(max_n, T.t->ne[1]);
+    }
+    const size_t P = C.em_gpu_pairs;
+    C.em_gpu_half = (size_t) C.em_gpu_chunk*(GGML_PAD(max_eb, 256) + A) + 3*A;
+    C.em_gpu_ids  = GGML_PAD(P*(size_t) max_k*sizeof(float), A);
+    C.em_gpu_y    = C.em_gpu_ids + GGML_PAD(P*sizeof(int32_t), A);
+    const size_t n_stage = 2*C.em_gpu_half + 4*A;
+    const size_t n_io    = C.em_gpu_y + GGML_PAD(P*(size_t) max_n*sizeof(float), A) + A;
+    // the device's budget left after the buffers: what the graphs' scratch and lists grow into
+    {
+        ggml_backend_dev_t dev = ggml_backend_get_device(C.gpu);
+        size_t fr = 0, tot = 0;
+        if (dev != nullptr) {
+            ggml_backend_dev_memory(dev, &fr, &tot);
+        }
+        const size_t keep = (size_t) C.em_gpu_keep_mb << 20;
+        if (tot > 0 && fr < n_stage + n_io + keep) {
+            C.em_gpu_failed = true;
+            LLAMA_LOG_WARN("expert cache: %.1f MiB free on %s, the expert-major GPU buffers (%.1f + %.1f MiB) would leave less than %u MiB, on the CPU\n",
+                    fr/1024.0/1024.0, ggml_backend_name(C.gpu), n_stage/1024.0/1024.0, n_io/1024.0/1024.0, C.em_gpu_keep_mb);
+            return false;
+        }
+    }
+    ggml_backend_buffer_t st = ggml_backend_buft_alloc_buffer(C.inner, n_stage);
+    ggml_backend_buffer_t io = st != nullptr ? ggml_backend_buft_alloc_buffer(C.inner, n_io) : nullptr;
+    if (st == nullptr || io == nullptr) {
+        if (st != nullptr) {
+            ggml_backend_buffer_free(st);
+        }
+        C.em_gpu_failed = true;
+        LLAMA_LOG_WARN("expert cache: %s could not hold the expert-major GPU buffers (%.1f + %.1f MiB), on the CPU\n",
+                ggml_backend_buft_name(C.inner), n_stage/1024.0/1024.0, n_io/1024.0/1024.0);
+        return false;
+    }
+    st->buft = &C.buft;
+    // before the first base: a write-combined compute buffer is moved to write-back there
+    ggml_backend_buffer_set_usage(io, GGML_BACKEND_BUFFER_USAGE_COMPUTE);
+    C.em_gpu_stage = st;
+    C.em_gpu_io    = io;
+    C.em_gpu_meta.resize(8*ggml_tensor_overhead() + ggml_graph_overhead_custom(8, false));
+    C.em_gpu_map.resize(P);
+    LLAMA_LOG_INFO("expert cache: expert-major matmuls on %s, staging 2 x %u experts (%.1f MiB), %zu pairs per dispatch (%.1f MiB)\n",
+            ggml_backend_name(C.gpu), C.em_gpu_chunk, n_stage/1024.0/1024.0, P, n_io/1024.0/1024.0);
+    return true;
+}
+
+// position p of staging half h for tensor T, and the stride (nb[2] of the staged experts): a padded
+// tensor's experts at the file offset's remainder, EC_DIRECT_ALIGN apart beyond their bytes, so that
+// they read in place as into the slots
+static char * ec_em_gpu_pos(const llama_expert_cache & C, const ec_tensor & T, int h, int32_t p, size_t * nb2) {
+    const size_t A    = EC_DIRECT_ALIGN;
+    char *       half = (char *) ggml_backend_buffer_get_base(C.em_gpu_stage) + (size_t) h*C.em_gpu_half;
+    char *       d0   = nullptr;
+    size_t       s    = 0;
+    if (T.pad) {
+        d0 = (char *) GGML_PAD((uintptr_t) half + A, A) + T.offs % A;
+        s  = T.eb + A;
+    } else {
+        d0 = (char *) GGML_PAD((uintptr_t) half, 256);
+        s  = GGML_PAD(T.eb, 256);
+    }
+    if (nb2 != nullptr) {
+        *nb2 = s;
+    }
+    return d0 + (size_t) p*s;
+}
+
+// the device takes T's matmul over its slots at the largest dispatch (asked once per tensor)
+static bool ec_em_gpu_ok(llama_expert_cache & C, ec_tensor & T) {
+    if (T.gpu_ok >= 0) {
+        return T.gpu_ok == 1;
+    }
+    if (!ec_em_gpu_alloc(C)) {
+        return false;
+    }
+    ggml_init_params ip = { C.em_gpu_meta.size(), C.em_gpu_meta.data(), true };
+    ggml_context * ctx = ggml_init(ip);
+    if (ctx == nullptr) {
+        return false;
+    }
+    ggml_tensor * x   = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, T.t->ne[0], 1, (int64_t) C.em_gpu_pairs);
+    ggml_tensor * ids = ggml_new_tensor_2d(ctx, GGML_TYPE_I32, 1, (int64_t) C.em_gpu_pairs);
+    ggml_tensor * y   = ggml_mul_mat_id(ctx, T.t, x, ids);
+    T.gpu_ok = ggml_backend_supports_op(C.gpu, y) ? 1 : 0;
+    ggml_free(ctx);
+    if (T.gpu_ok == 0) {
+        LLAMA_LOG_INFO("expert cache: %s (%s): expert-major on the CPU, %s has no kernel for it\n",
+                ggml_get_name(T.t), ggml_type_name(T.t->type), ggml_backend_name(C.gpu));
+    }
+    return T.gpu_ok == 1;
+}
+
+static void ec_spin(int & n) {
+    if (++n > 64) {
+        std::this_thread::yield();
+    }
+}
+
+// thread 0: dst's pairs of the experts es[i], expert lid[i] of the experts tensor, which is w (the
+// slots) or the n_as experts at as_data nb2 apart (a staging half). Up to em_gpu_pairs pairs a
+// dispatch: their activations gathered from b (the matmul's src[1]), the results scattered to dst. A
+// dispatch the device refuses or fails is computed on the CPU from the quantized activations q
+static void ec_em_gpu_run(llama_expert_cache & C, ec_em & E, ggml_tensor * dst, ggml_tensor * as_w,
+        char * as_data, size_t as_nb2, int32_t n_as) {
+    const ec_tensor &   T  = C.tensors[E.tensor];
+    ggml_tensor *       w  = T.t;
+    const ggml_tensor * q  = dst->src[0];
+    const ggml_tensor * b  = dst->src[1];
+    const int64_t k      = w->ne[0];
+    const int64_t n_rows = w->ne[1];
+    const int64_t n_used = dst->ne[1];
+    const int64_t ne11   = b->ne[1];
+    const int32_t P_max  = (int32_t) C.em_gpu_pairs;
+    char *    io = (char *) ggml_backend_buffer_get_base(C.em_gpu_io);
+    float *   X  = (float *) io;
+    int32_t * I  = (int32_t *) (io + C.em_gpu_ids);
+    float *   Y  = (float *) (io + C.em_gpu_y);
+    std::vector<int32_t> & map = C.em_gpu_map;
+    const std::vector<int32_t> & es  = C.em_gpu_es;
+    const std::vector<int32_t> & lid = C.em_gpu_lid;
+
+    auto flush = [&](int32_t P) {
+        const int64_t t0 = ggml_time_us();
+        ggml_init_params ip = { C.em_gpu_meta.size(), C.em_gpu_meta.data(), true };
+        ggml_context * ctx = C.em_gpu_failed ? nullptr : ggml_init(ip);
+        bool ok = ctx != nullptr;
+        ggml_tensor * as = as_w;
+        if (ok && as == nullptr) {
+            as = ggml_new_tensor_3d(ctx, w->type, k, n_rows, n_as);
+            as->nb[2] = as_nb2;
+            as->nb[3] = as_nb2*(size_t) n_as;
+            ok = ggml_backend_tensor_alloc(C.em_gpu_stage, as, as_data) == GGML_STATUS_SUCCESS;
+        }
+        if (ok) {
+            // fresh tensors, addresses set by init_tensor: no plan of an earlier dispatch replays
+            ggml_tensor * x   = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, k, 1, P);
+            ggml_tensor * ids = ggml_new_tensor_2d(ctx, GGML_TYPE_I32, 1, P);
+            ggml_tensor * y   = ggml_mul_mat_id(ctx, as, x, ids);
+            ok = ggml_backend_tensor_alloc(C.em_gpu_io, x, X) == GGML_STATUS_SUCCESS &&
+                 ggml_backend_tensor_alloc(C.em_gpu_io, ids, I) == GGML_STATUS_SUCCESS &&
+                 ggml_backend_tensor_alloc(C.em_gpu_io, y, Y) == GGML_STATUS_SUCCESS &&
+                 ggml_backend_supports_op(C.gpu, y);
+            if (ok) {
+                ggml_cgraph * gf = ggml_new_graph_custom(ctx, 4, false);
+                ggml_build_forward_expand(gf, y);
+                // thread 0 is the caller's thread: a throw from the backend (std::bad_alloc near the
+                // memory cap) would leave the graph mid-compute and reach the app (chain94: the
+                // 2327-token prefill died with 0x8007000E). The CPU takes this and every later dispatch
+                try {
+                    ok = ggml_backend_graph_compute(C.gpu, gf) == GGML_STATUS_SUCCESS;
+                } catch (const std::exception & ex) {
+                    ok = false;
+                    C.em_gpu_failed = true;
+                    LLAMA_LOG_WARN("expert cache: a GPU expert-major dispatch on %s threw (%s), expert-major back on the CPU\n",
+                            ggml_backend_name(C.gpu), ex.what());
+                } catch (...) {
+                    ok = false;
+                    C.em_gpu_failed = true;
+                    LLAMA_LOG_WARN("expert cache: a GPU expert-major dispatch on %s threw, expert-major back on the CPU\n",
+                            ggml_backend_name(C.gpu));
+                }
+            }
+        }
+        if (ctx != nullptr) {
+            ggml_free(ctx);
+        }
+        if (ok) {
+            for (int32_t j = 0; j < P; ++j) {
+                const int64_t kk = map[j] % n_used;
+                const int64_t t  = map[j] / n_used;
+                memcpy((char *) dst->data + kk*dst->nb[1] + t*dst->nb[2], Y + (size_t) j*n_rows, (size_t) n_rows*sizeof(float));
+            }
+        } else {
+            if (C.em_gpu_cpu.fetch_add(1) == 0) {
+                LLAMA_LOG_WARN("expert cache: a GPU expert-major dispatch on %s failed (%d pairs), on the CPU\n", ggml_get_name(w), P);
+            }
+            const ggml_type_traits_cpu * tr = ggml_get_type_traits_cpu(w->type);
+            const size_t qrs  = ggml_row_size(tr->vec_dot_type, k);
+            const char * base = as_w != nullptr ? (const char *) as_w->data : as_data;
+            const size_t nb2  = as_w != nullptr ? as_w->nb[2] : as_nb2;
+            for (int32_t j = 0; j < P; ++j) {
+                const int64_t kk  = map[j] % n_used;
+                const int64_t t   = map[j] / n_used;
+                const char *  src = (const char *) q->data + (size_t) (kk % ne11 + ne11*t)*qrs;
+                const char *  wd  = base + (size_t) I[j]*nb2;
+                float *       out = (float *) ((char *) dst->data + kk*dst->nb[1] + t*dst->nb[2]);
+                for (int64_t r = 0; r < n_rows; ++r) {
+                    tr->vec_dot((int) k, out + r, 0, wd + (size_t) r*w->nb[1], 0, src, 0, 1);
+                }
+            }
+        }
+        C.em_gpu_n++;
+        C.em_gpu_p  += (uint64_t) P;
+        C.em_gpu_us += (uint64_t) (ggml_time_us() - t0);
+    };
+
+    int32_t P = 0;
+    for (size_t i = 0; i < es.size(); ++i) {
+        const int32_t   e     = es[i];
+        const int32_t * pairs = E.pairs.data() + E.first[e];
+        for (int32_t j = 0; j < E.count[e]; ++j) {
+            const int64_t p  = pairs[j];
+            const int64_t kk = p % n_used;
+            const int64_t t  = p / n_used;
+            memcpy(X + (size_t) P*k, (const char *) b->data + (kk % ne11)*b->nb[1] + t*b->nb[2], (size_t) k*sizeof(float));
+            I[P]   = lid[i];
+            map[P] = (int32_t) p;
+            if (++P == P_max) {
+                flush(P);
+                P = 0;
+            }
+        }
+    }
+    if (P > 0) {
+        flush(P);
+    }
+}
