+// the GPU path of ec_em_mm: threads 1.. read the queue, thread 0 dispatches the slots' experts (the
+// resident ones and, once read, the round's), then each staging chunk as soon as it is read
+static void ec_em_mm_gpu(ggml_tensor * dst, int ith, ec_em & E, uint64_t & reads, uint64_t & hits,
+        uint64_t & file_b, uint64_t & file_us) {
+    llama_expert_cache & C = *E.cache;
+    ec_layer & L = *E.layer;
+    const ec_tensor & T = C.tensors[E.tensor];
+    ggml_tensor * w = T.t;
+    const int32_t nq    = (int32_t) E.gq.size();
+    const int32_t chunk = (int32_t) C.em_gpu_chunk;
+
+    if (ith != 0) {
+        for (int32_t i = E.gnext.fetch_add(1); i < nq; i = E.gnext.fetch_add(1)) {
+            const int32_t e = E.gq[i];
+            char *  buf = nullptr;
+            int32_t at  = 0;
+            if (i < E.n_kept) {
+                buf = (char *) w->data + (size_t) L.em_slot[e]*w->nb[2];
+            } else {
+                const int32_t c = (i - E.n_kept)/chunk;
+                int n = 0;
+                while (E.gdisp.load(std::memory_order_acquire) < c - 1) {
+                    ec_spin(n); // the half's previous chunk still computing
+                }
+                buf = ec_em_gpu_pos(C, T, c & 1, (i - E.n_kept) % chunk, nullptr);
+                at  = 1 + c;
+            }
+            const int64_t c0 = ggml_time_us();
+            ec_read(*C.files[T.file], ith, buf, T.eb, T.offs + (size_t) e*T.eb, T.pad);
+            file_us += (uint64_t) (ggml_time_us() - c0);
+            file_b  += T.eb;
+            reads++;
+            E.gread[at].fetch_add(1, std::memory_order_release);
+        }
+        return;
