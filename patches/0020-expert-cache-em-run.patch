+// LLAMA_EXPERT_EM_RUN: T's staged experts packed at their file stride, read as spans
+static bool ec_em_run_ok(const llama_expert_cache & C, const ec_tensor & T) {
+    return C.em_run >= 2 && T.eb % EC_DIRECT_ALIGN == 0;
 }
 
+// the spans of a read queue: each of gq[0, n_kept) alone, then the staged ones (sorted) cut where
+// the ids stop being consecutive, at a chunk's end and after max_run experts. (i0, len) pairs into
+// out; returns their number
+static int32_t ec_em_runs(const std::vector<int32_t> & gq, int32_t n_kept, int32_t chunk, int32_t max_run, std::vector<int32_t> & out) {
+    out.clear();
+    const int32_t nq = (int32_t) gq.size();
+    for (int32_t i = 0; i < n_kept && i < nq; ++i) {
+        out.push_back(i);
+        out.push_back(1);
+    }
+    for (int32_t i = std::max(n_kept, 0); i < nq; ) {
+        const int32_t c   = (i - n_kept)/chunk;
+        int32_t       len = 1;
+        while (i + len < nq && len < max_run && gq[i + len] == gq[i + len - 1] + 1 && (i + len - n_kept)/chunk == c) {
+            len++;
+        }
+        out.push_back(i);
+        out.push_back(len);
+        i += len;
+    }
+    return (int32_t) (out.size()/2);
+}
