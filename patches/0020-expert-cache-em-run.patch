+// the GPU path's read queue of E's experts (E.list, the slots given): the round's ones (into their
+// slots) first, then the missing ones to stage, the counters reset
+static void ec_em_gpu_queue(const llama_expert_cache & C, ec_em & E, const ec_layer & L) {
+    E.gq.clear();
+    for (int32_t e : E.list) {
+        if (L.em_slot[e] >= 0) {
+            E.gq.push_back(e);
+        }
+    }
+    E.n_kept = (int32_t) E.gq.size();
+    for (int32_t e : E.list) {
+        if (L.slot_of[e] < 0) {
+            E.gq.push_back(e);
+        }
+    }
+    const int32_t chunk = (int32_t) C.em_gpu_chunk;
+    E.n_chunk = ((int32_t) E.gq.size() - E.n_kept + chunk - 1)/chunk;
+    E.n_run   = 0;
+    if (ec_em_run_ok(C, C.tensors[E.tensor])) {
+        // the staged ones by id, so that a chunk's consecutive experts are one span of the file
+        std::sort(E.gq.begin() + E.n_kept, E.gq.end());
+        E.n_run = ec_em_runs(E.gq, E.n_kept, chunk, (int32_t) C.em_run, E.grun);
+    }
+    if (E.n_gread < E.n_chunk + 1) {
+        E.gread.reset(new std::atomic<int32_t>[(size_t) E.n_chunk + 1]);
+        E.n_gread = E.n_chunk + 1;
+    }
+    for (int32_t i = 0; i < E.n_gread; ++i) {
+        E.gread[i].store(0, std::memory_order_relaxed);
+    }
+    E.gnext.store(0, std::memory_order_relaxed);
+    E.gdisp.store(0, std::memory_order_relaxed);
+}
