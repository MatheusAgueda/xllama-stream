+// LLAMA_EXPERT_EM_RUN: [offs, offs + n) into dst without writing a byte outside [dst, dst + n), the
+// span's aligned middle in place (unbuffered, when dst sits at the offset's remainder) and the
+// partial blocks at its ends through the thread's staging buffer; buffered, one read
+static void ec_read_run(ec_file & f, int ith, char * dst, size_t n, size_t offs) {
+    if (!f.direct || f.dio[ith].state < 0) {
+        ec_read(f, ith, dst, n, offs);
+        return;
+    }
+    const size_t A   = EC_DIRECT_ALIGN;
+    const size_t end = offs + n;
+    const size_t m0  = std::min(end, (offs + A - 1)/A*A);
+    const size_t m1  = std::max(m0, end/A*A);
+    if (m0 > offs) {
+        ec_read(f, ith, dst, m0 - offs, offs);
+    }
+    if (m1 > m0) {
+        ec_read(f, ith, dst + (m0 - offs), m1 - m0, m0);
+    }
+    if (end > m1) {
+        ec_read(f, ith, dst + (m1 - offs), end - m1, m1);
+    }
+}
