diff --git a/src/models/qwen35.cpp b/src/models/qwen35.cpp
index ab98744..4e19f53 100644
--- a/src/models/qwen35.cpp
+++ b/src/models/qwen35.cpp
@@ -35,7 +35,10 @@ void llama_model_qwen35::load_arch_tensors(llama_model_loader & ml) {
 
     const bool mtp_only = (hparams.n_layer_nextn > 0) && (ml.get_weight("blk.0.attn_norm.weight") == nullptr);
     const int trunk_flags = mtp_only ? TENSOR_NOT_REQUIRED : 0;
-    int mtp_flags = !ml.load_mtp ? TENSOR_SKIP : 0;
+    // xllama patch 0006: a GGUF may declare nextn_predict_layers yet ship without the
+    // MTP block (heretic/abliterated re-quants drop it); without MTP the block is
+    // skipped anyway, so a missing tensor must not fail the load.
+    int mtp_flags = !ml.load_mtp ? (TENSOR_SKIP | TENSOR_NOT_REQUIRED) : 0;
 
     tok_embd = create_tensor(tn(LLM_TENSOR_TOKEN_EMBD, "weight"), { n_embd, n_vocab }, 0);
 
