+ggml_tensor * llama_expert_cache_build_trace(ggml_context * ctx, ggml_tensor * w, ggml_tensor * scores, ggml_tensor * selected) {
+    ec_layer * layer = ec_layer_of(w);
+    // prompts only: a decode token keeps the graph (and the GPU route) it has without the trace
+    if (layer == nullptr || !layer->cache->trace_prompt || layer->cache->trace == nullptr || scores->ne[1] < 2) {
+        return nullptr;
+    }
+    if (scores->type != GGML_TYPE_F32 || scores->nb[0] != sizeof(float) || scores->ne[2] != 1 || scores->ne[3] != 1 ||
+            scores->ne[0] != (int64_t) layer->slot_of.size() || selected->ne[0] < 1) {
+        return nullptr;
+    }
+    ggml_tensor * srcs[2] = { scores, selected };
+    ggml_tensor * tr = ggml_custom_4d(ctx, GGML_TYPE_I32, 1, 1, 1, 1, srcs, 2, ec_trace_only, 1, layer);
+    ggml_format_name(tr, "ffn_moe_trace-%d", layer->id);
+    return tr;
+}
+
+void llama_expert_cache_trace_tokens(llama_expert_cache & cache, const int32_t * tokens, int32_t n_tokens, int32_t pos0) {
+    if (!cache.trace_prompt || cache.trace_tok == nullptr || cache.trace == nullptr || n_tokens < 1) {
+        return;
+    }
+    std::lock_guard<std::mutex> lock(cache.trace_mu);
+    const int32_t head[4] = { 0x314B4345 /* "ECK1" */, n_tokens, pos0, 0 };
+    const int64_t off     = (int64_t) ftell(cache.trace);
+    fwrite(head, sizeof(head), 1, cache.trace_tok);
+    fwrite(&off, sizeof(off), 1, cache.trace_tok);
+    if (tokens != nullptr) {
+        fwrite(tokens, sizeof(int32_t), (size_t) n_tokens, cache.trace_tok);
+    } else {
+        for (int32_t i = 0; i < n_tokens; ++i) {
+            const int32_t none = -1;
+            fwrite(&none, sizeof(none), 1, cache.trace_tok);
+        }
+    }
+    fflush(cache.trace_tok);
+}
