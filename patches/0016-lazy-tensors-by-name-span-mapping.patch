+// LLAMA_LAZY_TENSORS=<name>[,<name>...]: tensors read on demand whatever the lazy mode and their size, e.g. the
+// host-resident token_embd / output of an expert-cache model, which then stay file-backed instead of private copies.
+// Read at every call, so a later load in the same process sees the value its caller set.
+bool llama_model_loader::lazy_read::forced(const std::string & name) {
+    const char * env = getenv("LLAMA_LAZY_TENSORS");
+    if (env == nullptr || *env == '\0') {
+        return false;
+    }
+    std::string cur;
+    for (const char * p = env; ; ++p) {
+        if (*p == ',' || *p == '\0') {
+            if (cur == name) {
+                return true;
+            }
+            cur.clear();
+            if (*p == '\0') {
+                return false;
+            }
+        } else if (*p != ' ') {
+            cur += *p;
+        }
+    }
+}
+
