+// LLAMA_EXPERT_HOST: the system's available physical memory and commit, the lower of the two, in MB
+// (SIZE_MAX where not measured)
+static size_t ec_host_avail_mb() {
+#if defined(_WIN32)
+    MEMORYSTATUSEX ms = {};
+    ms.dwLength = sizeof(ms);
+    if (GlobalMemoryStatusEx(&ms)) {
+        return (size_t) (std::min(ms.ullAvailPhys, ms.ullAvailPageFile) >> 20);
+    }
+    return 0;
+#else
+    return SIZE_MAX;
+#endif
 }
 
+// LLAMA_EXPERT_HOST: the layer's share of the tier, at its first plan (the model and the context's
+// buffers are allocated by then). Fewer entries when the share would leave under h_keep_mb available
+static void ec_host_alloc(ec_layer & L) {
+    llama_expert_cache & C = *L.cache;
+    L.h_tried = true;
+
+    const int32_t n_expert = (int32_t) L.slot_of.size();
+    const int32_t n_slots  = (int32_t) L.expert_of.size();
+    L.h_toff.resize(L.tensors.size());
+    size_t eb = 0;
+    for (size_t i = 0; i < L.tensors.size(); ++i) {
+        L.h_toff[i] = eb;
+        eb += (C.tensors[L.tensors[i]].eb + 63) & ~(size_t) 63;
+    }
+    if (eb == 0 || n_expert <= n_slots) {
+        return;
+    }
+
+    const size_t  share = (size_t) C.h_mib*1024*1024 / std::max<size_t>(C.layers.size(), 1);
+    const int64_t want  = std::min<int64_t>((int64_t) (share / eb), n_expert - n_slots);
+    int64_t n = want;
+    const size_t avail = ec_host_avail_mb();
+    if (avail != SIZE_MAX) {
+        const size_t room = avail > C.h_keep_mb ? (avail - C.h_keep_mb)*1024*1024 : 0;
+        n = std::min<int64_t>(n, (int64_t) (room / eb));
+    }
+    char * buf = nullptr;
+    while (n > 0 && (buf = new (std::nothrow) char[(size_t) n*eb]) == nullptr) {
+        n /= 2;
+    }
+    if (L.id == C.first_layer || (n < want && !C.h_short)) {
+        C.h_short = C.h_short || n < want;
+        LLAMA_LOG_INFO("%s: expert cache: host tier of layer %d: %" PRId64 " of %" PRId64 " entries of %.2f MiB, %zu MB available (keep %u)\n",
+                __func__, L.id, n, want, eb/1024.0/1024.0, avail == SIZE_MAX ? (size_t) 0 : avail, C.h_keep_mb);
+    }
+    if (n <= 0) {
+        return;
+    }
+    L.h_buf.reset(buf);
+    L.h_eb = eb;
+    L.h_n  = (int32_t) n;
+    L.h_of.assign(n_expert, -1);
+    L.h_exp.assign((size_t) n, -1);
+    L.h_used.assign((size_t) n, 0);
+    L.h_jobs.reserve((size_t) n_slots);
+    C.h_alloc   += (uint64_t) n*eb;
+    C.h_entries += (uint64_t) n;
+}
+
+// LLAMA_EXPERT_HOST: slot goes from old (-1: empty) to the missing expert e. Queues the copies: e from
+// its entry (true: no read) and old to an entry unless it has one. The entries of this ubatch's
+// experts are pinned (h_used == tick): the load op reads them, no save may take them
+static bool ec_host_plan(ec_layer & L, int32_t slot, int32_t old, int32_t e, uint64_t tick) {
+    const bool keep = old >= 0 && L.h_of[old] < 0;
+    const int32_t he = L.h_of[e];
+    if (he >= 0) {
+        L.h_of[e] = -1;
+        L.h_used[he] = tick;
+        if (keep) {
+            L.h_exp[he]  = old;
+            L.h_of[old]  = he;
+            L.h_jobs.push_back({ slot, e, he, EC_H_SWAP });
+        } else {
+            L.h_exp[he] = -1; // free from the next plan on
+            L.h_jobs.push_back({ slot, e, he, EC_H_FILL });
+        }
+        return true;
+    }
+    if (keep) {
+        int32_t hv = -1;
+        for (int32_t h = 0; h < L.h_n; ++h) {
+            if (L.h_used[h] == tick) {
+                continue;
+            }
+            if (hv < 0 || (L.h_exp[h] < 0) > (L.h_exp[hv] < 0) ||
+                    ((L.h_exp[h] < 0) == (L.h_exp[hv] < 0) && L.h_used[h] < L.h_used[hv])) {
+                hv = h;
+            }
+        }
+        if (hv >= 0) {
+            if (L.h_exp[hv] >= 0) {
+                L.h_of[L.h_exp[hv]] = -1;
+            }
+            L.h_exp[hv]  = old;
+            L.h_of[old]  = hv;
+            L.h_used[hv] = tick;
+            L.h_jobs.push_back({ slot, e, hv, EC_H_SAVE });
+        }
+    }
+    return false;
+}
