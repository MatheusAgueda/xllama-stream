+static void ec_swap_bytes(char * a, char * b, size_t n) {
+    alignas(64) char tmp[16384];
+    for (size_t o = 0; o < n; o += sizeof(tmp)) {
+        const size_t k = std::min(sizeof(tmp), n - o);
+        memcpy(tmp, a + o, k);
+        memcpy(a + o, b + o, k);
+        memcpy(b + o, tmp, k);
+    }
+}
