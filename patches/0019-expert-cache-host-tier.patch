+// LLAMA_EXPERT_HOST: a copy between a slot and an entry of the layer's host tier, done by the load op
+// before its disk reads. SAVE: the slot's expert (the plan's victim) to the entry; FILL: the entry's
+// expert to the slot; SWAP: both at once (the victim takes the entry the missing expert leaves)
+enum ec_hkind : uint8_t { EC_H_SAVE, EC_H_FILL, EC_H_SWAP };
