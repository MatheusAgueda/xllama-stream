index 0000000..4de6eec
--- /dev/null
+++ b/src/llama-expert-cache.cpp
@@ -0,0 +1,818 @@
+#include "llama-expert-cache.h"
+
+#include "llama-impl.h"
+
+#include "../ggml/src/ggml-backend-impl.h"
+
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <cerrno>
+#include <cinttypes>
+#include <condition_variable>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <deque>
+#include <mutex>
+#include <stdexcept>
+#include <thread>
+#include <unordered_map>
+#include <utility>
+#include <vector>
+
+#if defined(_WIN32)
+#    ifndef WIN32_LEAN_AND_MEAN
+#        define WIN32_LEAN_AND_MEAN
+#    endif
+#    ifndef NOMINMAX
+#        define NOMINMAX
+#    endif
+#    include <windows.h>
+#    include <io.h>
+#else
+#    include <unistd.h>
+#endif
+
+namespace {
+
+struct ec_file {
+    std::string path;
+    // one handle per compute thread: positional reads on separate file objects run in parallel
+    std::array<FILE *, GGML_MAX_N_THREADS> fp {};
+
+    ~ec_file() {
+        for (FILE * f : fp) {
+            if (f) {
+                fclose(f);
+            }
+        }
+    }
+};
+
+struct ec_tensor {
+    ggml_tensor * t;
+    size_t  file;
+    size_t  offs;  // file offset of expert 0
+    int32_t layer;
+};
+
+enum ec_pf_state : int { EC_PF_QUEUED, EC_PF_RUNNING, EC_PF_DONE, EC_PF_CANCELLED };
+
+// one read of a prefetch round: expert into slot, which held old_expert (last used at old_used)
+struct ec_pf {
+    int32_t  slot       = -1;
+    int32_t  expert     = -1;
+    int32_t  old_expert = -1;
+    uint64_t old_used   = 0;
+    std::atomic<int> state {EC_PF_DONE};
+};
+
+struct ec_layer {
+    llama_expert_cache * cache = nullptr;
+    int32_t id = -1;
+    std::vector<size_t>   tensors;   // indices into llama_expert_cache::tensors
+    std::vector<int32_t>  slot_of;   // expert -> slot, -1 if not resident
+    std::vector<int32_t>  expert_of; // slot -> expert, -1 if empty
+    std::vector<uint64_t> used;      // slot -> tick of the last plan (or prefetch) that used it
+    std::vector<std::pair<int32_t, int32_t>> pending; // (slot, expert) read by the load op of this ubatch
+    uint64_t tick = 0;
+    std::vector<int32_t> order; // select and prefetch op scratch
+    std::atomic<int64_t> load_us {0}; // slowest thread of the last load op, not yet in read_us
+
+    std::unique_ptr<ec_pf[]> pf;  // the current prefetch round, n_pf of n_slots jobs
+    int32_t n_pf = 0;
+    std::vector<uint64_t> seen;   // expert -> tick of the last prefetch that ranked it
+    std::vector<int32_t>  ranked; // prefetch scratch: each token's predicted experts, best first
+    std::vector<int32_t>  missing;
+};
+
+} // namespace
+
+struct llama_expert_cache {
+    uint32_t n_slots       = 0;
+    uint32_t n_expert_used = 1;
+    float    swap_ratio    = 0.0f;
+
+    ggml_backend_buffer_type buft {};
+
+    std::vector<std::unique_ptr<ec_file>> files;
+    std::vector<ec_tensor> tensors;
+    std::unordered_map<const ggml_tensor *, size_t> tensor_idx;
+    std::unordered_map<int32_t, std::unique_ptr<ec_layer>> layers;
+    int32_t first_layer = INT32_MAX;
+
+    std::atomic<uint64_t> hits    {0};
+    std::atomic<uint64_t> misses  {0};
+    std::atomic<uint64_t> swaps   {0};
+    std::atomic<uint64_t> bytes   {0};
+    std::atomic<uint64_t> read_us {0}; // wall time of the load ops (their slowest thread)
+    uint64_t n_rounds = 0; // plans of first_layer, i.e. ubatches
+
+    // pre-gating prefetch: pf_k predicted experts per token, read by I/O threads ahead of the plan
+    uint32_t pf_k = 0;
+    std::atomic<uint64_t> pf_reads     {0}; // experts read ahead
+    std::atomic<uint64_t> pf_used      {0}; // of those, used by the ubatch they were read for
+    std::atomic<uint64_t> pf_cancelled {0}; // dropped before their read started
+    std::atomic<uint64_t> pf_wait_us   {0}; // plans waiting for reads in flight
+    std::mutex pf_mtx;
+    std::condition_variable pf_cv;
+    std::deque<std::pair<ec_layer *, int32_t>> pf_queue;
+    bool pf_stop = false;
+    std::vector<std::thread> pf_threads;
+
+    void pf_enqueue(ec_layer & L);
+    void pf_shutdown();
+
+    void log_stats(const char * when) const {
+        const uint64_t h = hits.load();
+        const uint64_t m = misses.load();
+        uint64_t us = read_us.load();
+        for (const auto & it : layers) {
+            us += (uint64_t) it.second->load_us.load();
+        }
+        char pf[160] = "";
+        if (pf_k > 0) {
+            snprintf(pf, sizeof(pf), "; prefetch %" PRIu64 " read (%" PRIu64 " used), %" PRIu64 " dropped, %.0f ms waited",
+                    pf_reads.load(), pf_used.load(), pf_cancelled.load(), pf_wait_us.load()/1000.0);
+        }
+        LLAMA_LOG_INFO("expert cache (%s): %u slots x %zu layers, %" PRIu64 " ubatches, %" PRIu64 " hits, %" PRIu64 " misses (%.1f%% hit), %" PRIu64 " swaps, %.1f MiB read in %.0f ms%s\n",
+                when, n_slots, layers.size(), n_rounds, h, m, h + m ? 100.0*h/(h + m) : 0.0, swaps.load(), bytes.load()/1024.0/1024.0, us/1000.0, pf);
+    }
+
+    ~llama_expert_cache() {
+        pf_shutdown();
+        if (n_rounds > 0) {
+            log_stats("final");
+        }
+    }
+};
+
+//
+// buffer type: a CPU buffer whose expert tensors were shrunk to n_slots experts
+//
+
+static const char * ec_buft_get_name(ggml_backend_buffer_type_t buft) {
+    GGML_UNUSED(buft);
+    return "EXPERT_CACHE";
+}
+
+static ggml_backend_buffer_type_t ec_cpu_buft() {
+    ggml_backend_dev_t dev = ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_CPU);
+    GGML_ASSERT(dev != nullptr && "expert cache needs the CPU backend");
+    return ggml_backend_dev_buffer_type(dev);
+}
+
+static ggml_backend_buffer_t ec_buft_alloc_buffer(ggml_backend_buffer_type_t buft, size_t size) {
+    ggml_backend_buffer_t buf = ggml_backend_buft_alloc_buffer(ec_cpu_buft(), size);
+    if (buf) {
+        buf->buft = buft; // CPU buffer whose tensors are sized by this type
+    }
+    return buf;
+}
+
+static size_t ec_buft_get_alignment(ggml_backend_buffer_type_t buft) {
+    GGML_UNUSED(buft);
+    return ggml_backend_buft_get_alignment(ec_cpu_buft());
+}
+
+static bool ec_buft_is_host(ggml_backend_buffer_type_t buft) {
+    GGML_UNUSED(buft);
+    return true;
+}
+
+static llama_expert_cache * ec_of_buft(ggml_backend_buffer_type_t buft) {
+    if (buft == nullptr || buft->iface.get_name != ec_buft_get_name) {
+        return nullptr;
+    }
+    return (llama_expert_cache *) buft->context;
+}
+
+static llama_expert_cache * ec_of(const ggml_tensor * t) {
+    if (t == nullptr || t->buffer == nullptr) {
+        return nullptr;
+    }
+    return ec_of_buft(ggml_backend_buffer_get_type(t->buffer));
+}
+
+//
+// positional read, safe to run from every compute thread at once
+//
+
+static void ec_read(ec_file & f, int ith, void * dst, size_t n, size_t offs) {
+    FILE *& fp = f.fp[ith];
+    if (fp == nullptr) {
+        fp = ggml_fopen(f.path.c_str(), "rb");
+        if (fp == nullptr) {
+            GGML_ABORT("expert cache: cannot open %s: %s", f.path.c_str(), strerror(errno));
+        }
+    }
+
+    size_t done = 0;
+#if defined(_WIN32)
+    HANDLE h = (HANDLE) _get_osfhandle(_fileno(fp));
+    while (done < n) {
+        const uint64_t pos = (uint64_t) offs + done;
+        OVERLAPPED ov = {};
+        ov.Offset     = (DWORD) (pos & 0xFFFFFFFFu);
+        ov.OffsetHigh = (DWORD) (pos >> 32);
+        const DWORD want = (DWORD) std::min<size_t>(n - done, (size_t) 1 << 30);
+        DWORD got = 0;
+        if (!ReadFile(h, (char *) dst + done, want, &got, &ov) || got == 0) {
+            GGML_ABORT("expert cache: read of %zu bytes at %" PRIu64 " failed (error %lu)", (size_t) want, pos, (unsigned long) GetLastError());
+        }
+        done += got;
+    }
+#else
+    const int fd = fileno(fp);
+    while (done < n) {
+        const ssize_t got = pread(fd, (char *) dst + done, n - done, (off_t) (offs + done));
+        if (got < 0 && errno == EINTR) {
+            continue;
+        }
+        if (got <= 0) {
+            GGML_ABORT("expert cache: read of %zu bytes at %zu failed: %s", n - done, offs + done, got == 0 ? "end of file" : strerror(errno));
+        }
+        done += (size_t) got;
+    }
+#endif
+}
+
+//
+// pre-gating prefetch: I/O threads read the experts a layer is predicted to route to while the
+// graph computes the layer's attention; the layer's plan settles the round before it maps ids
+//
+
+// the I/O threads take file handles from the top of ec_file::fp, the compute threads from the bottom
+static constexpr int EC_PF_THREADS = 2;
+
+static void ec_pf_worker(llama_expert_cache * C, int ith) {
+    for (;;) {
+        ec_layer * L = nullptr;
+        int32_t i = -1;
+        {
+            std::unique_lock<std::mutex> lock(C->pf_mtx);
+            C->pf_cv.wait(lock, [C] { return C->pf_stop || !C->pf_queue.empty(); });
+            if (C->pf_stop) {
+                return;
+            }
+            L = C->pf_queue.front().first;
+            i = C->pf_queue.front().second;
+            C->pf_queue.pop_front();
+        }
+        // an entry left from a settled round finds its job finished, dropped or already re-queued:
+        // only the thread that moves it from queued to running reads, after the plan wrote it
+        ec_pf & j = L->pf[i];
+        int st = EC_PF_QUEUED;
+        if (!j.state.compare_exchange_strong(st, EC_PF_RUNNING, std::memory_order_acq_rel)) {
+            continue;
+        }
+        size_t bytes = 0;
+        for (size_t ti : L->tensors) {
+            const ec_tensor & T = C->tensors[ti];
+            const size_t nb2 = T.t->nb[2];
+            ec_read(*C->files[T.file], ith, (char *) T.t->data + (size_t) j.slot*nb2, nb2, T.offs + (size_t) j.expert*nb2);
+            bytes += nb2;
+        }
+        C->bytes    += bytes;
+        C->pf_reads += 1;
+        j.state.store(EC_PF_DONE, std::memory_order_release);
+    }
+}
+
+void llama_expert_cache::pf_enqueue(ec_layer & L) {
+    {
+        std::lock_guard<std::mutex> lock(pf_mtx);
+        if (pf_threads.empty()) {
+            for (int k = 0; k < EC_PF_THREADS; ++k) {
+                pf_threads.emplace_back(ec_pf_worker, this, GGML_MAX_N_THREADS - 1 - k);
+            }
+        }
+        for (int32_t i = 0; i < L.n_pf; ++i) {
+            pf_queue.emplace_back(&L, i);
+        }
+    }
+    pf_cv.notify_all();
+}
+
+// end a layer's prefetch round: reads not started are dropped and their slots get the old expert
+// back (its data was never overwritten), reads in flight are waited for; finished jobs stay listed
+// (n_pf) for the plan's count of the ones it uses
+static void ec_settle(ec_layer & L) {
+    llama_expert_cache & C = *L.cache;
+    int64_t  t0      = 0;
+    uint64_t dropped = 0;
+    for (int32_t i = 0; i < L.n_pf; ++i) {
+        ec_pf & j = L.pf[i];
+        int st = EC_PF_QUEUED;
+        if (j.state.compare_exchange_strong(st, EC_PF_CANCELLED, std::memory_order_acq_rel)) {
+            L.slot_of[j.expert]  = -1;
+            L.expert_of[j.slot]  = j.old_expert;
+            if (j.old_expert >= 0) {
+                L.slot_of[j.old_expert] = j.slot;
+            }
+            L.used[j.slot] = j.old_used;
+            dropped++;
+            continue;
+        }
+        while (st == EC_PF_RUNNING) {
+            if (t0 == 0) {
+                t0 = ggml_time_us();
+            }
+            std::this_thread::yield();
+            st = j.state.load(std::memory_order_acquire);
+        }
+    }
+    if (t0 != 0) {
+        C.pf_wait_us += (uint64_t) (ggml_time_us() - t0);
+    }
+    if (dropped > 0) {
+        C.pf_cancelled += dropped;
+    }
+}
+
+void llama_expert_cache::pf_shutdown() {
+    for (auto & it : layers) {
+        ec_settle(*it.second);
+        it.second->n_pf = 0;
+    }
+    {
+        std::lock_guard<std::mutex> lock(pf_mtx);
+        pf_stop = true;
+        pf_queue.clear();
+    }
+    pf_cv.notify_all();
+    for (auto & t : pf_threads) {
+        t.join();
+    }
+    pf_threads.clear();
+}
+
+//
+// graph ops
+//
+
+static int32_t ec_id_at(const ggml_tensor * ids, int64_t i0, int64_t i1) {
+    return *(const int32_t *) ((const char *) ids->data + i0*ids->nb[0] + i1*ids->nb[1]);
+}
+
+// 1 thread: pre-gating prefetch of the layer's next plan. src = router logits [n_expert, n_tokens]
+// of an earlier residual (top-k only: no softmax needed). Each token's top pf_k, rank by rank:
+// resident ones are pinned, the others take the least recently used slots outside the prediction
+// and are queued for the I/O threads, best first; dst = unused
+static void ec_prefetch(ggml_tensor * dst, int ith, int nth, void * userdata) {
+    GGML_UNUSED(nth);
+    if (ith != 0) {
+        return;
+    }
+
+    ec_layer & L = *(ec_layer *) userdata;
+    llama_expert_cache & C = *L.cache;
+    const ggml_tensor * logits = dst->src[0];
+
+    const int32_t n_expert = (int32_t) L.slot_of.size();
+    const int32_t n_slots  = (int32_t) L.expert_of.size();
+    const int64_t n_tokens = logits->ne[1];
+    const int32_t k        = std::min<int32_t>((int32_t) C.pf_k, n_expert);
+
+    // a round no plan settled (a graph stopped by its abort callback)
+    ec_settle(L);
+    L.n_pf = 0;
+    if (k <= 0 || n_tokens <= 0) {
+        return;
+    }
+
+    std::vector<int32_t> & order = L.order;
+    order.resize((size_t) n_expert);
+    L.ranked.resize((size_t) (n_tokens*k));
+    for (int64_t t = 0; t < n_tokens; ++t) {
+        const float * s = (const float *) ((const char *) logits->data + t*logits->nb[1]);
+        for (int32_t e = 0; e < n_expert; ++e) {
+            order[e] = e;
+        }
+        std::partial_sort(order.begin(), order.begin() + k, order.end(), [s](int32_t a, int32_t b) {
+            return s[a] > s[b] || (s[a] == s[b] && a < b);
+        });
+        std::copy(order.begin(), order.begin() + k, L.ranked.begin() + t*k);
+    }
+
+    const uint64_t tick = ++L.tick;
+    L.missing.clear();
+    for (int32_t r = 0; r < k; ++r) {
+        for (int64_t t = 0; t < n_tokens; ++t) {
+            const int32_t e = L.ranked[t*k + r];
+            if (L.seen[e] == tick) {
+                continue;
+            }
+            L.seen[e] = tick;
+            const int32_t s = L.slot_of[e];
+            if (s >= 0) {
+                L.used[s] = tick;
+            } else {
+                L.missing.push_back(e);
+            }
+        }
+    }
+
+    // an evicted expert is never one of the predicted: the resident ones were all pinned first
+    for (const int32_t e : L.missing) {
+        int32_t victim = -1;
+        for (int32_t s = 0; s < n_slots; ++s) {
+            if (L.used[s] != tick && (victim < 0 || L.used[s] < L.used[victim])) {
+                victim = s;
+            }
+        }
+        if (victim < 0) {
+            break;
+        }
+        ec_pf & j = L.pf[L.n_pf++];
+        j.slot       = victim;
+        j.expert     = e;
+        j.old_expert = L.expert_of[victim];
+        j.old_used   = L.used[victim];
+        if (j.old_expert >= 0) {
+            L.slot_of[j.old_expert] = -1;
+        }
+        L.expert_of[victim] = e;
+        L.slot_of[e]        = victim;
+        L.used[victim]      = tick;
+        j.state.store(EC_PF_QUEUED, std::memory_order_release);
+    }
+    if (L.n_pf > 0) {
+        C.pf_enqueue(L);
+    }
+}
+
+// 1 thread: each token's top-k by router score, then resident experts outside it take the place
+// of missing ones inside it - the strongest resident for the weakest missing - while the
+// resident's score is at least swap_ratio times the missing one's; dst = expert ids
+static void ec_select(ggml_tensor * dst, int ith, int nth, void * userdata) {
+    GGML_UNUSED(nth);
+    if (ith != 0) {
+        return;
+    }
+
+    ec_layer & L = *(ec_layer *) userdata;
+    llama_expert_cache & C = *L.cache;
+    const ggml_tensor * scores = dst->src[0];
+
+    const int64_t n_expert = scores->ne[0];
+    const int64_t n_tokens = scores->ne[1];
+    const int64_t n_used   = dst->ne[0];
+
+    std::vector<int32_t> & order = L.order;
+    order.resize((size_t) n_expert);
+
+    uint64_t swaps = 0;
+    for (int64_t t = 0; t < n_tokens; ++t) {
+        const float * s = (const float *) ((const char *) scores->data + t*scores->nb[1]);
+        for (int32_t e = 0; e < (int32_t) n_expert; ++e) {
+            order[e] = e;
+        }
+        std::sort(order.begin(), order.end(), [s](int32_t a, int32_t b) {
+            return s[a] > s[b] || (s[a] == s[b] && a < b);
+        });
+
+        int64_t i = n_used; // next resident candidate outside the top-k, strongest first
+        for (int64_t j = n_used - 1; j >= 0; --j) { // missing experts inside it, weakest first
+            const int32_t m = order[j];
+            if (L.slot_of[m] >= 0) {
+                continue;
+            }
+            while (i < n_expert && L.slot_of[order[i]] < 0) {
+                i++;
+            }
+            if (i == n_expert) {
+                break;
+            }
+            const int32_t r = order[i];
+            if (!(s[r] > 0.0f) || s[r] < C.swap_ratio*s[m]) {
+                break; // weaker candidates and stronger missing experts only from here
+            }
+            std::swap(order[j], order[i]);
+            i++;
+            swaps++;
+        }
+
+        int32_t * out = (int32_t *) ((char *) dst->data + t*dst->nb[1]);
+        for (int64_t k = 0; k < n_used; ++k) {
+            out[k] = order[k];
+        }
+    }
+    if (swaps > 0) {
+        C.swaps += swaps;
+    }
+}
+
+// 1 thread: LRU slot assignment for the experts of this ubatch; dst = slot ids
+static void ec_plan(ggml_tensor * dst, int ith, int nth, void * userdata) {
+    GGML_UNUSED(nth);
+    if (ith != 0) {
+        return;
+    }
+
+    ec_layer & L = *(ec_layer *) userdata;
+    llama_expert_cache & C = *L.cache;
+    const ggml_tensor * ids = dst->src[0];
+
+    const int64_t n_used   = ids->ne[0];
+    const int64_t n_tokens = ids->ne[1];
+    const int32_t n_expert = (int32_t) L.slot_of.size();
+    const int32_t n_slots  = (int32_t) L.expert_of.size();
+
+    // the prefetch round of this layer, if any: no read into its slots after this point
+    ec_settle(L);
+
+    const uint64_t tick    = ++L.tick;
+
+    L.pending.clear();
+    C.read_us += (uint64_t) L.load_us.exchange(0);
+
+    // resident experts: pin them for this ubatch
+    uint64_t hits = 0;
+    for (int64_t i1 = 0; i1 < n_tokens; ++i1) {
+        for (int64_t i0 = 0; i0 < n_used; ++i0) {
+            const int32_t e = ec_id_at(ids, i0, i1);
+            GGML_ASSERT(e >= 0 && e < n_expert);
+            const int32_t s = L.slot_of[e];
+            if (s >= 0 && L.used[s] != tick) {
+                L.used[s] = tick;
+                hits++;
+            }
+        }
+    }
+
+    uint64_t pf_used = 0;
+    for (int32_t i = 0; i < L.n_pf; ++i) {
+        const ec_pf & j = L.pf[i];
+        if (j.state.load(std::memory_order_relaxed) == EC_PF_DONE && L.used[j.slot] == tick) {
+            pf_used++;
+        }
+    }
+    L.n_pf = 0;
+    if (pf_used > 0) {
+        C.pf_used += pf_used;
+    }
+
+    // missing experts: take the least recently used slot that this ubatch does not need
+    for (int64_t i1 = 0; i1 < n_tokens; ++i1) {
+        for (int64_t i0 = 0; i0 < n_used; ++i0) {
+            const int32_t e = ec_id_at(ids, i0, i1);
+            if (L.slot_of[e] >= 0) {
+                continue;
+            }
+            int32_t victim = -1;
+            for (int32_t s = 0; s < n_slots; ++s) {
+                if (L.used[s] != tick && (victim < 0 || L.used[s] < L.used[victim])) {
+                    victim = s;
+                }
+            }
+            if (victim < 0) {
+                GGML_ABORT("expert cache: layer %d needs more than %d experts in one ubatch - lower n_ubatch", L.id, n_slots);
+            }
+            if (L.expert_of[victim] >= 0) {
+                L.slot_of[L.expert_of[victim]] = -1;
+            }
+            L.expert_of[victim] = e;
+            L.slot_of[e]        = victim;
+            L.used[victim]      = tick;
+            L.pending.emplace_back(victim, e);
+        }
+    }
+
+    int32_t * out = (int32_t *) dst->data;
+    for (int64_t i1 = 0; i1 < n_tokens; ++i1) {
+        for (int64_t i0 = 0; i0 < n_used; ++i0) {
+            out[i1*n_used + i0] = L.slot_of[ec_id_at(ids, i0, i1)];
+        }
+    }
+
+    C.hits   += hits;
+    C.misses += L.pending.size();
+    if (L.id == C.first_layer && ++C.n_rounds % 64 == 0) {
+        C.log_stats("running");
+    }
+}
+
+// all threads: read the pending experts of every tensor of the layer into their slots; dst = slot ids
+static void ec_load(ggml_tensor * dst, int ith, int nth, void * userdata) {
+    ec_layer & L = *(ec_layer *) userdata;
+    llama_expert_cache & C = *L.cache;
+
+    const size_t n_t    = L.tensors.size();
+    const size_t n_jobs = L.pending.size()*n_t;
+
+    const int64_t t0 = (size_t) ith < n_jobs ? ggml_time_us() : 0;
+    size_t bytes = 0;
+    for (size_t j = ith; j < n_jobs; j += nth) {
+        const auto & job = L.pending[j / n_t];
+        const ec_tensor & T = C.tensors[L.tensors[j % n_t]];
+        const size_t nb2 = T.t->nb[2];
+        ec_read(*C.files[T.file], ith, (char *) T.t->data + (size_t) job.first*nb2, nb2, T.offs + (size_t) job.second*nb2);
+        bytes += nb2;
+    }
+    if (bytes > 0) {
+        C.bytes += bytes;
+        // the threads start together after the graph barrier: the op lasts as long as the slowest
+        const int64_t dt = ggml_time_us() - t0;
+        int64_t prev = L.load_us.load();
+        while (prev < dt && !L.load_us.compare_exchange_weak(prev, dt)) {
+        }
+    }
+
+    if (ith == 0) {
+        memcpy(dst->data, dst->src[0]->data, ggml_nbytes(dst));
+    }
+}
+
+//
+// API
+//
+
+std::shared_ptr<llama_expert_cache> llama_expert_cache_init(uint32_t n_slots, uint32_t n_expert_used, float swap_ratio) {
+    auto cache = std::make_shared<llama_expert_cache>();
+
+    cache->n_expert_used = std::max<uint32_t>(1, n_expert_used);
+    cache->n_slots       = std::max(n_slots, cache->n_expert_used);
+    cache->swap_ratio    = swap_ratio > 0.0f ? swap_ratio : 0.0f; // NaN and negatives: exact routing
+
+    // LLAMA_EXPERT_PREFETCH: predicted experts per token read ahead (0 = off), default n_expert_used
+    const char * pf = getenv("LLAMA_EXPERT_PREFETCH");
+    cache->pf_k = pf != nullptr && *pf != '\0' ? (uint32_t) std::min(std::max(atoi(pf), 0), 64) : cache->n_expert_used;
+
+    cache->buft = {
+        /* .iface = */ {
+            /* .get_name         = */ ec_buft_get_name,
+            /* .alloc_buffer     = */ ec_buft_alloc_buffer,
+            /* .alloc_buffer_n   = */ nullptr,
+            /* .get_alignment    = */ ec_buft_get_alignment,
+            /* .get_max_size     = */ nullptr,
+            /* .get_alloc_size   = */ nullptr, // the tensors are shrunk, ggml_nbytes is their size
+            /* .get_alloc_size_n = */ nullptr,
+            /* .is_host          = */ ec_buft_is_host,
+        },
+        /* .device  = */ ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_CPU),
+        /* .context = */ cache.get(),
+    };
+
+    return cache;
+}
+
+ggml_backend_buffer_type_t llama_expert_cache_buft(llama_expert_cache & cache) {
+    return &cache.buft;
+}
+
+uint32_t llama_expert_cache_n_slots(const llama_expert_cache & cache) {
+    return cache.n_slots;
+}
+
+float llama_expert_cache_swap_ratio(const llama_expert_cache & cache) {
+    return cache.swap_ratio;
+}
+
+uint32_t llama_expert_cache_prefetch(const llama_expert_cache & cache) {
+    return cache.pf_k;
+}
+
+void llama_expert_cache_stop(llama_expert_cache & cache) {
+    cache.pf_shutdown();
+}
+
+uint32_t llama_expert_cache_max_ubatch(const llama_expert_cache & cache) {
+    return std::max<uint32_t>(1, cache.n_slots / cache.n_expert_used);
+}
+
+bool llama_expert_cache_wants(ggml_backend_buffer_type_t buft, const ggml_tensor * t) {
+    const llama_expert_cache * cache = ec_of_buft(buft);
+    return cache != nullptr && t->ne[3] == 1 && t->ne[2] > (int64_t) cache->n_slots &&
+           t->nb[2] == t->nb[1]*(size_t) t->ne[1];
+}
+
+void llama_expert_cache_shrink(ggml_backend_buffer_type_t buft, ggml_tensor * t) {
+    if (!llama_expert_cache_wants(buft, t)) {
+        return;
+    }
+    t->ne[2] = ec_of_buft(buft)->n_slots;
+    t->nb[3] = t->nb[2]*(size_t) t->ne[2];
+}
+
+bool llama_expert_cache_has(const ggml_tensor * t) {
+    return ec_of(t) != nullptr;
+}
+
+void llama_expert_cache_bind(ggml_tensor * t, const std::string & path, size_t offs, int64_t n_expert) {
+    llama_expert_cache * cache = ec_of(t);
+    GGML_ASSERT(cache != nullptr);
+
+    if (path.empty()) {
+        throw std::runtime_error("expert cache: the model must be loaded from a file path");
+    }
+
+    int32_t il = -1;
+    if (sscanf(ggml_get_name(t), "blk.%d.", &il) != 1 || il < 0) {
+        throw std::runtime_error(std::string("expert cache: no layer in tensor name ") + ggml_get_name(t));
+    }
+    if (t->ne[3] != 1 || t->ne[2] != (int64_t) cache->n_slots || n_expert <= t->ne[2] ||
+            t->nb[2] != t->nb[1]*(size_t) t->ne[1]) {
+        throw std::runtime_error(std::string("expert cache: unsupported layout for ") + ggml_get_name(t));
+    }
+
+    size_t file = 0;
+    while (file < cache->files.size() && cache->files[file]->path != path) {
+        file++;
+    }
+    if (file == cache->files.size()) {
+        cache->files.emplace_back(new ec_file());
+        cache->files.back()->path = path;
+    }
+
+    auto & slot = cache->layers[il];
+    if (!slot) {
+        slot.reset(new ec_layer());
+        slot->cache = cache;
+        slot->id    = il;
+        slot->slot_of.assign(n_expert, -1);
+        slot->expert_of.assign(cache->n_slots, -1);
+        slot->used.assign(cache->n_slots, 0);
+        slot->pf.reset(new ec_pf[cache->n_slots]);
+        slot->seen.assign(n_expert, 0);
+        cache->first_layer = std::min(cache->first_layer, il);
+    }
+    if ((int64_t) slot->slot_of.size() != n_expert) {
+        throw std::runtime_error(std::string("expert cache: expert count differs within the layer of ") + ggml_get_name(t));
+    }
+
+    cache->tensor_idx[t] = cache->tensors.size();
+    slot->tensors.push_back(cache->tensors.size());
+    cache->tensors.push_back({ t, file, offs, il });
+}
+
+// the cache layer of a bound expert tensor, nullptr otherwise
+static ec_layer * ec_layer_of(const ggml_tensor * w) {
+    llama_expert_cache * cache = ec_of(w);
+    if (cache == nullptr) {
+        return nullptr;
+    }
+    const auto it = cache->tensor_idx.find(w);
+    if (it == cache->tensor_idx.end()) {
+        // not bound: weights never loaded (memory-fit pass), nothing will be computed
+        return nullptr;
+    }
+    return cache->layers.at(cache->tensors[it->second].layer).get();
+}
+
+ggml_tensor * llama_expert_cache_build_select(ggml_context * ctx, ggml_tensor * w, ggml_tensor * scores, int64_t n_used) {
+    ec_layer * layer = ec_layer_of(w);
+    if (layer == nullptr || !(layer->cache->swap_ratio > 0.0f)) {
+        return nullptr;
+    }
+    // one row of scores per token, one score per expert of the tensor
+    if (scores->type != GGML_TYPE_F32 || scores->nb[0] != sizeof(float) || scores->ne[2] != 1 || scores->ne[3] != 1 ||
+            scores->ne[0] != (int64_t) layer->slot_of.size() || n_used < 1 || n_used > scores->ne[0]) {
+        return nullptr;
+    }
+
+    ggml_tensor * sel = ggml_custom_4d(ctx, GGML_TYPE_I32, n_used, scores->ne[1], 1, 1, &scores, 1, ec_select, 1, layer);
+    ggml_format_name(sel, "ffn_moe_select-%d", layer->id);
+    return sel;
+}
+
+bool llama_expert_cache_prefetches(const ggml_tensor * w) {
+    const ec_layer * layer = ec_layer_of(w);
+    return layer != nullptr && layer->cache->pf_k > 0;
+}
+
+ggml_tensor * llama_expert_cache_build_prefetch(ggml_context * ctx, ggml_tensor * w, ggml_tensor * logits) {
+    ec_layer * layer = ec_layer_of(w);
+    if (layer == nullptr || layer->cache->pf_k == 0) {
+        return nullptr;
+    }
+    if (logits->type != GGML_TYPE_F32 || logits->nb[0] != sizeof(float) || logits->ne[2] != 1 || logits->ne[3] != 1 ||
+            logits->ne[0] != (int64_t) layer->slot_of.size()) {
+        return nullptr;
+    }
+
+    ggml_tensor * pf = ggml_custom_4d(ctx, GGML_TYPE_I32, 1, 1, 1, 1, &logits, 1, ec_prefetch, 1, layer);
+    ggml_format_name(pf, "ffn_moe_prefetch-%d", layer->id);
+    return pf;
+}
+
+ggml_tensor * llama_expert_cache_build_ids(ggml_context * ctx, ggml_tensor * w, ggml_tensor * selected_experts) {
+    ec_layer * layer = ec_layer_of(w);
+    if (layer == nullptr) {
+        return nullptr;
+    }
+
+    GGML_ASSERT(selected_experts->type == GGML_TYPE_I32);
+
+    const int64_t n_used   = selected_experts->ne[0];
+    const int64_t n_tokens = selected_experts->ne[1];
+
+    ggml_tensor * plan = ggml_custom_4d(ctx, GGML_TYPE_I32, n_used, n_tokens, 1, 1, &selected_experts, 1, ec_plan, 1, layer);
+    ggml_format_name(plan, "ffn_moe_slot_plan-%d", layer->id);
+
+    ggml_tensor * slots = ggml_custom_4d(ctx, GGML_TYPE_I32, n_used, n_tokens, 1, 1, &plan, 1, ec_load, GGML_N_TASKS_MAX, layer);
+    ggml_format_name(slots, "ffn_moe_slots-%d", layer->id);
+
+    return slots;
+}
