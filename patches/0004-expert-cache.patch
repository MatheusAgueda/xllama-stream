+#pragma once
+
+#include "ggml.h"
+#include "ggml-backend.h"
+
+#include <cstdint>
+#include <memory>
+#include <string>
+
+// Routed-expert cache for MoE models larger than memory (llama_model_params.n_expert_slots > 0).
+//
+// Every routed `*_exps.weight` tensor is created with n_slots experts instead of the n_expert of the
+// GGUF, so its buffer holds only the resident ones. The loader does not read these tensors; it
+// records where they live in the file. In build_moe_ffn two custom ops run before the expert matmuls
+// of each layer:
+//   plan (1 thread): map the router's expert ids to slots (LRU per layer) and list the misses
+//   load (all threads): read the missed experts with positional reads into their slots
+// The mul_mat_id ops take the slot ids; router weights, biases and scales keep the real ids.
+// With a swap ratio, a third op replaces the top-k: resident experts just outside a token's top-k
+// stand in for missing ones inside it (cache-aware routing, approximate).
+// Pre-gating prefetch (LLAMA_EXPERT_PREFETCH = k, default n_expert_used, 0 = off): the layer's router
+// applied to its input residual predicts its routing before the attention; a fourth op queues the
+// predicted experts that are missing for background I/O threads, and the plan drops the reads not
+// started and waits for the running ones. Routing is unchanged: the output stays exact.
+// The expert matmuls run on the CPU (other layers may be offloaded), one context per model at a
+// time, n_ubatch <= n_slots / n_expert_used.
+
+struct llama_expert_cache;
+
+std::shared_ptr<llama_expert_cache> llama_expert_cache_init(uint32_t n_slots, uint32_t n_expert_used, float swap_ratio);
+
+ggml_backend_buffer_type_t llama_expert_cache_buft(llama_expert_cache & cache);
+
+uint32_t llama_expert_cache_n_slots(const llama_expert_cache & cache);
+
+// 0 when routing is exact
+float llama_expert_cache_swap_ratio(const llama_expert_cache & cache);
+
+// predicted experts per token read ahead, 0 when prefetch is off
+uint32_t llama_expert_cache_prefetch(const llama_expert_cache & cache);
+
+// end every read in flight and stop the I/O threads, before the expert buffers are freed
+void llama_expert_cache_stop(llama_expert_cache & cache);
+
+// largest ubatch whose experts always fit in the slots
+uint32_t llama_expert_cache_max_ubatch(const llama_expert_cache & cache);
+
+// loader: buft is an expert-cache type and t (as in the GGUF) a stack of more experts than it keeps
+bool llama_expert_cache_wants(ggml_backend_buffer_type_t buft, const ggml_tensor * t);
+
+// loader: resize a tensor just created for buft to the n_slots experts its buffer will hold
+void llama_expert_cache_shrink(ggml_backend_buffer_type_t buft, ggml_tensor * t);
+
+// true if t lives in an expert-cache buffer
+bool llama_expert_cache_has(const ggml_tensor * t);
+
+// loader: t is read on demand from `path` (expert e at offs + e*nb[2], n_expert of them in the file)
+// instead of at load time
+void llama_expert_cache_bind(ggml_tensor * t, const std::string & path, size_t offs, int64_t n_expert);
+
+// graph: the n_used experts of each token from router scores [n_expert, n_tokens] (F32, positive
+// for probabilities), cache-aware; nullptr if w is not cached or the swap ratio is 0, in which case
+// the caller keeps its own top-k
+ggml_tensor * llama_expert_cache_build_select(ggml_context * ctx, ggml_tensor * w, ggml_tensor * scores, int64_t n_used);
+
+// graph: true if the layer of w is cached and prefetch is on
+bool llama_expert_cache_prefetches(const ggml_tensor * w);
+
+// graph: the prefetch op of w's layer from predicted router logits [n_expert, n_tokens] (F32), or
+// nullptr; nothing consumes it, the caller expands it where the reads should start
+ggml_tensor * llama_expert_cache_build_prefetch(ggml_context * ctx, ggml_tensor * w, ggml_tensor * logits);
+
+// graph: slot ids replacing `selected_experts` for the mul_mat_id ops on the experts of w's layer,
+// or nullptr if w is not cached
+ggml_tensor * llama_expert_cache_build_ids(ggml_context * ctx, ggml_tensor * w, ggml_tensor * selected_experts);
