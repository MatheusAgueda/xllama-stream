+// llama_expert_stats::route_hash / route_n and llama_model_expert_route_reset exist (xllama patch 0028)
+#define LLAMA_HAS_EXPERT_ROUTE_HASH 1
+
 #define LLAMA_FILE_MAGIC_GGLA 0x67676c61u // 'ggla'
 #define LLAMA_FILE_MAGIC_GGSN 0x6767736eu // 'ggsn'
