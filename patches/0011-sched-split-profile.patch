+// xllama patch 0011: GGML_SCHED_PROFILE (set, not "0") times every split, its
+// input copies and its compute until the backend is idle, keyed by backend and
+// first..last node name (layer suffix dropped); ggml_backend_sched_free logs
+// the totals. It synchronizes each split, so async backends lose overlap.
+struct ggml_sched_prof_stat {
+    uint64_t n = 0;
+    int64_t  copy_us = 0;
+    int64_t  comp_us = 0;
+};
+static std::mutex g_sched_prof_mu;
+static std::unordered_map<const void *, std::map<std::string, ggml_sched_prof_stat>> g_sched_prof;
+
+// read per graph, not cached: the host may set it per model before a context
+static bool ggml_sched_prof_on() {
+    const char * v = getenv("GGML_SCHED_PROFILE");
+    return v != nullptr && strcmp(v, "0") != 0;
+}
+
+static std::string ggml_sched_prof_name(const struct ggml_tensor * t) {
+    std::string s = t->name[0] ? t->name : ggml_op_desc(t);
+    const size_t paren = s.find(" (");
+    if (paren != std::string::npos) {
+        s.resize(paren);
+    }
+    const size_t dash = s.rfind('-');
+    if (dash != std::string::npos && dash + 1 < s.size() &&
+            s.find_first_not_of("0123456789", dash + 1) == std::string::npos) {
+        s.resize(dash);
+    }
+    return s;
+}
+
+static void ggml_sched_prof_print(ggml_backend_sched_t sched) {
+    std::map<std::string, ggml_sched_prof_stat> m;
+    {
+        std::lock_guard<std::mutex> lock(g_sched_prof_mu);
+        auto it = g_sched_prof.find(sched);
+        if (it == g_sched_prof.end()) {
+            return;
+        }
+        m.swap(it->second);
+        g_sched_prof.erase(it);
+    }
+    std::vector<std::pair<std::string, ggml_sched_prof_stat>> v(m.begin(), m.end());
+    std::sort(v.begin(), v.end(), [](const auto & a, const auto & b) {
+        return a.second.copy_us + a.second.comp_us > b.second.copy_us + b.second.comp_us;
+    });
+    int64_t tot = 0;
+    for (const auto & e : v) {
+        tot += e.second.copy_us + e.second.comp_us;
+    }
+    GGML_LOG_INFO("sched profile: %zu split kinds, %.1f ms\n", v.size(), tot / 1000.0);
+    for (size_t i = 0; i < v.size() && i < 40; i++) {
+        const auto & e = v[i];
+        GGML_LOG_INFO("sched split: %8llu x %9.1f ms (copy %7.1f) %s\n", (unsigned long long) e.second.n,
+                (e.second.copy_us + e.second.comp_us) / 1000.0, e.second.copy_us / 1000.0, e.first.c_str());
+    }
+}
