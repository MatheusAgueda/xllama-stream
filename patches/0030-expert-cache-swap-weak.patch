 // ratio of two scores: unnormalized probabilities give the same swaps); in the weakest n_tail ranks
 // any resident with a positive score stands in (cache-conditional top-k: those ranks are computed
 // when free and never read); res = expert -> resident (>= 0) or missing; returns the swaps made
+//
+// weak (LLAMA_EXPERT_SWAP_WEAK): the same test per pair, as many stand-ins as it allows, spent on the
+// weakest missing ranks: the t weakest missing take the t strongest residents outside the top n_used,
+// the strongest of those missing with the strongest resident, t the largest for which every pair
+// passes. A pair's need (ratio times the missing score, 0 in the tail) falls with the rank, so this
+// sorted pairing is a maximum matching and the t weakest are always a feasible set: the walk below
+// stops at its first failure and gives its strongest resident to the weakest missing expert instead
+static uint64_t ec_swap_weak(const std::vector<int32_t> & res, std::vector<int32_t> & order, const float * s, int64_t n_used,
+                             float ratio, int64_t n_tail) {
+    const int64_t n_expert = (int64_t) order.size();
+    GGML_ASSERT(n_used <= 64);
+    int64_t miss[64]; // ranks of the missing experts inside the top n_used, strongest first
+    int64_t cand[64]; // ranks of the residents outside it, strongest first (at most one per missing)
+    int64_t nm = 0, nc = 0;
+    for (int64_t j = 0; j < n_used; ++j) {
+        if (res[order[j]] < 0) {
+            miss[nm++] = j;
+        }
+    }
+    for (int64_t i = n_used; i < n_expert && nc < nm; ++i) {
+        if (res[order[i]] >= 0) {
+            cand[nc++] = i;
+        }
+    }
+    int64_t t = std::min(nm, nc);
+    for (; t > 0; --t) {
+        bool ok = true;
+        for (int64_t k = 0; k < t && ok; ++k) {
+            const int64_t j = miss[nm - t + k];
+            const int32_t m = order[j];
+            const int32_t r = order[cand[k]];
+            const float   rj = n_used - j <= n_tail ? 0.0f : ratio;
+            ok = s[r] > 0.0f && !(s[r] < rj*s[m]);
+        }
+        if (ok) {
+            break;
+        }
+    }
+    for (int64_t k = 0; k < t; ++k) {
+        std::swap(order[miss[nm - t + k]], order[cand[k]]);
+    }
+    return (uint64_t) t;
+}
