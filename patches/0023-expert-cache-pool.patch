+
+// LLAMA_EXPERT_POOL: hand the shared slot allocation to layer L, evicting the previous owner first.
+// Called at the first residency-touching op of each layer. The router scores that op needs depend on
+// the previous layer's output, so that layer's expert matmuls are finished and its slots are free.
+static void ec_pool_claim(ec_layer & L) {
+    llama_expert_cache & C = *L.cache;
+    if (!C.pool || C.pool_owner == &L) {
+        return;
+    }
+    if (ec_layer * P = C.pool_owner) {
+        ec_settle(*P);
+        ec_drop_unloaded(*P);
+        ec_em_end(*P);
+        for (int32_t s = 0; s < (int32_t) P->expert_of.size(); ++s) {
+            if (P->expert_of[s] >= 0) {
+                ec_evict(*P, s, P->expert_of[s]);
+            }
+        }
+    }
+    C.pool_owner = &L;
 }
 
