+        return nullptr;
+    }
+    ggml_tensor * srcs[2] = { selected_experts, slots };
+    ggml_tensor * mask = ggml_custom_4d(ctx, GGML_TYPE_F32, 1, selected_experts->ne[0], selected_experts->ne[1], 1, srcs, 2, ec_late_mask, 1, layer);
+    ggml_format_name(mask, "ffn_moe_late_mask-%d", layer->id);
+    return mask;
+}
