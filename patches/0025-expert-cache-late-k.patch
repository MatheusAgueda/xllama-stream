+// LLAMA_EXPERT_LATE_K: 1 where this decode ubatch's plan found the routed expert missing, 0 where
+// it was resident, in the router weights' layout [1, n_used, n_tokens]; src[1], the slot ids, only
+// orders it after the layer's load op
+static void ec_late_mask(ggml_tensor * dst, int ith, int nth, void * userdata) {
+    GGML_UNUSED(nth);
+    if (ith != 0) {
+        return;
+    }
+    ec_layer & L = *(ec_layer *) userdata;
+    const ggml_tensor * ids = dst->src[0];
+    const int64_t n_used   = ids->ne[0];
+    const int64_t n_tokens = ids->ne[1];
+    float * out = (float *) dst->data;
+    for (int64_t i1 = 0; i1 < n_tokens; ++i1) {
+        for (int64_t i0 = 0; i0 < n_used; ++i0) {
