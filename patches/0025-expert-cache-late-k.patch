+            out[i1*n_used + i0] = std::find(L.late.begin(), L.late.end(), e) != L.late.end() ? 1.0f : 0.0f;
+        }
+    }
+    // consumed: a ubatch whose plan did not run can never reuse it
+    L.late.clear();
+}
